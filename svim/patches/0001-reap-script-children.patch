 void* g_workspace;
 
+static void reap_children(int signal_number) {
+  (void)signal_number;
+  int saved_errno = errno;
+
+  while (waitpid(-1, NULL, WNOHANG) > 0) {
+  }
+
+  errno = saved_errno;
+}
