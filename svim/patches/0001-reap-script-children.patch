+  child_exit.sa_handler = reap_children;
+  child_exit.sa_flags = SA_NOCLDSTOP | SA_RESTART;
+  sigemptyset(&child_exit.sa_mask);
+  if (sigaction(SIGCHLD, &child_exit, NULL) == -1) {
