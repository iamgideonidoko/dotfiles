#!/usr/bin/env bash
# Shared window navigation for shell and Karabiner launchers.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

windows() {
  local response
  response=$(omniwmctl query windows --json) || {
    echo 'OmniWM IPC unavailable: finish permission setup and enable IPC in its menu.' >&2
    return 1
  }
  jq -r 'if .ok == true and .result.kind == "windows" then .result.payload.windows
    else error("OmniWM returned an invalid window query") end' <<<"$response"
}

case "${1:-}" in
  resize)
    [[ $# == 2 && ( $2 == grow || $2 == shrink ) ]] || exit 64
    response=$(omniwmctl query workspaces --current --json) || exit
    layout=$(jq -er 'select(.ok == true) | .result.payload.workspaces
      | if length == 1 then .[0].layout else error("No unique current workspace") end
      | select(. == "niri" or . == "dwindle")' <<<"$response") || exit
    if [[ $layout == niri ]]; then
      # Match the configured five-percent Niri resize step.
      delta='+5%'
      [[ $2 == shrink ]] && delta='-5%'
      omniwmctl command set-container-primary-span "$delta"
    else
      omniwmctl command resize-focused "$2"
    fi
    ;;
  list)
    windows | jq -r '.[] | [.id, .app.name, .title] | @tsv'
    ;;
  navigate)
    [[ $# == 2 ]] || exit 64
    omniwmctl window navigate "$2"
    ;;
  previous)
    [[ $# == 1 ]] || exit 64
    dotfiles-window-history previous
    ;;
  app)
    [[ $# == 2 ]] || exit 64
    if pgrep -x OmniWM >/dev/null; then
      current_windows=$(windows) || exit
      bundle_id=''
      for app_path in "/Applications/$2.app" "$HOME/Applications/$2.app"; do
        if [[ -d $app_path ]]; then
          bundle_id=$(mdls -raw -name kMDItemCFBundleIdentifier "$app_path") || exit
          [[ $bundle_id == '(null)' ]] && bundle_id=''
          break
        fi
      done
      app_windows=$(jq -c --arg app "$2" --arg bundle "$bundle_id" '[.[]
        | select(.app.name == $app or ($bundle != "" and .app.bundleId == $bundle))]
        | sort_by(.isFocused != true)' <<<"$current_windows")
      window_id=$(jq -r '.[0].id // empty' <<<"$app_windows")
      if [[ $(jq 'length > 1 and (.[0].isFocused != true)' <<<"$app_windows") == true ]]; then
        # macOS retains each app's focused window even while another app is active.
        pid=$(jq -r '.[0].pid' <<<"$app_windows")
        native_id=$(python3 - "$pid" <<'PY'
import ctypes as c
import sys

ax = c.CDLL('/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices')
cf = c.CDLL('/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation')
ax.AXUIElementCreateApplication.argtypes = [c.c_int]
ax.AXUIElementCreateApplication.restype = c.c_void_p
ax.AXUIElementCopyAttributeValue.argtypes = [c.c_void_p, c.c_void_p, c.POINTER(c.c_void_p)]
ax._AXUIElementGetWindow.argtypes = [c.c_void_p, c.POINTER(c.c_uint32)]
cf.CFStringCreateWithCString.argtypes = [c.c_void_p, c.c_char_p, c.c_uint32]
cf.CFStringCreateWithCString.restype = c.c_void_p
cf.CFRelease.argtypes = [c.c_void_p]
app = ax.AXUIElementCreateApplication(int(sys.argv[1]))
try:
    for name in (b'AXFocusedWindow', b'AXMainWindow'):
        key = cf.CFStringCreateWithCString(None, name, 0x08000100)
        window = c.c_void_p()
        try:
            if ax.AXUIElementCopyAttributeValue(app, key, c.byref(window)) == 0:
                try:
                    window_id = c.c_uint32()
                    if ax._AXUIElementGetWindow(window, c.byref(window_id)) == 0:
                        print(window_id.value)
                        break
                finally:
                    cf.CFRelease(window)
        finally:
            cf.CFRelease(key)
    else:
        sys.exit('Cannot read the app focused window; check Accessibility permissions.')
finally:
    cf.CFRelease(app)
PY
        ) || exit
        window_id=$(jq -r --argjson native "$native_id" \
          '[.[] | select(.windowId == $native)][0].id // empty' <<<"$app_windows")
        [[ -n $window_id ]] || {
          echo 'The app focused window is not managed by OmniWM.' >&2
          exit 1
        }
      fi
      if [[ -n $window_id ]]; then
        omniwmctl window navigate "$window_id"
        exit
      fi
    fi
    open -a "$2"
    ;;
  emulator)
    current_windows=$(windows) || exit
    window_id=$(jq -r '[.[] | select((.app.name // "") | contains("qemu-system-aarch64"))]
      | .[0].id // empty' <<<"$current_windows")
    if [[ -n $window_id ]]; then
      omniwmctl window navigate "$window_id"
      exit
    fi
    emulator="$HOME/Library/Android/sdk/emulator/emulator"
    [[ -x $emulator ]] || { echo "Android emulator not found: $emulator" >&2; exit 1; }
    avds=$("$emulator" -list-avds) || exit
    avd=$(head -n 1 <<<"$avds")
    [[ -n $avd ]] || { echo 'No Android virtual devices found' >&2; exit 1; }
    "$emulator" -avd "$avd" >/dev/null 2>&1 &
    ;;
  *)
    echo 'Usage: window {list|navigate <id>|previous|app <name>|emulator|resize <grow|shrink>}' >&2
    exit 64
    ;;
esac
