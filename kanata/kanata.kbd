;; Generated by config.ts. Run: make kanata

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  linux-device-detect-mode keyboard-only
)

(defsrc)

(deflayermap (base)
  caps   (tap-hold-press 200 200 caps (layer-while-held hyper))
  ___    _
)

(deflayermap (hyper)
  b      (layer-while-held browse)
  o      (layer-while-held open)
  e      (layer-while-held mouse)
  w      (layer-while-held window)
  s      (layer-while-held system)
  v      (layer-while-held move)
  c      (layer-while-held music)
)

(deflayermap (browse)
  x      (cmd-log none error omarchy-launch-browser https://x.com)
)

(deflayermap (open)
  a      (cmd-log none error hyprctl dispatch cyclenext)
  c      (cmd-log none error omarchy-launch-or-focus google-chrome "uwsm-app -- gtk-launch google-chrome.desktop")
  j      (cmd-log none error omarchy-launch-or-focus google-chrome "uwsm-app -- gtk-launch google-chrome.desktop")
  g      (cmd-log none error omarchy-launch-or-focus com.mitchellh.ghostty "uwsm-app -- gtk-launch com.mitchellh.ghostty.desktop")
  f      (cmd-log none error omarchy-launch-or-focus org.gnome.Nautilus "uwsm-app -- gtk-launch org.gnome.Nautilus.desktop")
  s      (cmd-log none error omarchy-launch-or-focus spotify "uwsm-app -- omarchy-launch-webapp https://open.spotify.com/")
  d      (cmd-log none error omarchy-launch-or-focus dictionary "uwsm-app -- omarchy-launch-webapp https://www.google.com/search?q=define%3A")
  n      (cmd-log none error omarchy-launch-or-focus obsidian "uwsm-app -- gtk-launch obsidian.desktop")
  k      (cmd-log none error omarchy-launch-or-focus slack "uwsm-app -- omarchy-launch-webapp https://app.slack.com/client/")
  w      (cmd-log none error omarchy-launch-or-focus whatsapp "uwsm-app -- gtk-launch WhatsApp.desktop")
  r      (cmd-log none error omarchy-launch-or-focus discord "uwsm-app -- gtk-launch Discord.desktop")
  p      (cmd-log none error omarchy-launch-or-focus postman "uwsm-app -- gtk-launch postman.desktop")
  z      (cmd-log none error omarchy-launch-or-focus zoom "uwsm-app -- gtk-launch Zoom.desktop")
  h      (cmd-log none error omarchy-launch-or-focus notion "uwsm-app -- omarchy-launch-webapp https://www.notion.so/")
  b      (cmd-log none error omarchy-launch-or-focus dbeaver "uwsm-app -- gtk-launch io.dbeaver.DBeaverCommunity.desktop")
  l      (cmd-log none error omarchy-launch-or-focus blender "uwsm-app -- gtk-launch blender.desktop")
  y      (cmd-log none error omarchy-launch-or-focus youtube "uwsm-app -- gtk-launch YouTube.desktop")
  m      (cmd-log none error omarchy-launch-or-focus youtube-music "uwsm-app -- omarchy-launch-webapp https://music.youtube.com/")
  e      (cmd-log none error omarchy-launch-or-focus photopea "uwsm-app -- omarchy-launch-webapp https://www.photopea.com/")
  t      (cmd-log none error omarchy-launch-or-focus jetbrains-studio "uwsm-app -- gtk-launch android-studio.desktop")
  x      XX
  ,      XX
  .      XX
  i      XX
)

(deflayermap (mouse)
  f      (cmd-log none error kact activate elements)
  /      (cmd-log none error kact activate grid)
  h      (movemouse-accel-left 1 800 2 24)
  j      (movemouse-accel-down 1 800 2 24)
  k      (movemouse-accel-up 1 800 2 24)
  l      (movemouse-accel-right 1 800 2 24)
  ret    mlft
  spc    mlft
  i      (mwheel-up 50 120)
  o      (mwheel-down 50 120)
  ,      (mwheel-left 50 120)
  .      (mwheel-right 50 120)
  lctl   (layer-while-held mouse-control)
  lmet   (layer-while-held mouse-fast)
  rmet   (layer-while-held mouse-right-click)
  lalt   (layer-while-held mouse-slow)
)

(deflayermap (mouse-control)
  h      left
  j      down
  k      up
  l      rght
  spc    mmid
)

(deflayermap (mouse-fast)
  h      (movemouse-accel-left 1 800 8 96)
  j      (movemouse-accel-down 1 800 8 96)
  k      (movemouse-accel-up 1 800 8 96)
  l      (movemouse-accel-right 1 800 8 96)
)

(deflayermap (mouse-right-click)
  ret    mrgt
  spc    mrgt
)

(deflayermap (mouse-slow)
  h      (movemouse-accel-left 1 800 1 10)
  j      (movemouse-accel-down 1 800 1 10)
  k      (movemouse-accel-up 1 800 1 10)
  l      (movemouse-accel-right 1 800 1 10)
  ret    mmid
)

(deflayermap (window)
  e      (macro esc esc)
  i      C-S-tab
  o      C-tab
  p      (cmd-log none error hyprctl dispatch cyclenext prev)
  n      (cmd-log none error hyprctl dispatch cyclenext)
  lmet   (layer-while-held window-meta)
)

(deflayermap (window-meta)
  i      mbck
  o      mfwd
)

(deflayermap (system)
  o      (cmd-log none error omarchy-audio-output-volume raise)
  i      (cmd-log none error omarchy-audio-output-volume lower)
  k      (cmd-log none error omarchy-brightness-display +5%)
  j      (cmd-log none error omarchy-brightness-display 5%-)
  l      (cmd-log none error omarchy-system-lock)
  c      S-M-c
)

(deflayermap (move)
  h      left
  j      down
  k      up
  l      rght
  i      pgdn
  o      pgup
)

(deflayermap (music)
  spc    (cmd-log none error playerctl play-pause)
  k      (cmd-log none error playerctl next)
  j      (cmd-log none error playerctl previous)
)
