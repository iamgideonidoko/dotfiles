{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": { "1": "#c4a7e7", "2": "#ebbcba" },
    "padding": { "top": 2 },
  },
  "display": {
    "color": {
      "title": "#ebbcba",
      "keys": "#c4a7e7",
      "output": "#e0def4",
      "separator": "#908caa",
    },
    "bar": { "color": { "elapsed": "#9ccfd8", "total": "#403d52" } },
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "editor",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true,
    },
    "memory",
    "disk",
    {
      "type": "battery",
      "temp": true,
    },
    {
      "type": "localip",
      "showIpv6": false,
      "showMac": false,
    },
    "wifi",
    "datetime",
    "break",
    "colors",
    {
      "type": "gpu",
      "temp": true,
    },
  ],
}
